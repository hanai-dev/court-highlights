{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/exec", { "prepareCmd": "sh tools/release/build.sh ${nextRelease.version}" }],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "dist/ch-box-*" }],
        "successComment": false,
        "failComment": false,
        "failTitle": false,
        "releasedLabels": false
      }
    ]
  ]
}
