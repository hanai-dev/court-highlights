# The court box service (RUNBOOK §1). Installed by the install image (DEV-INSTALL-IMAGE) to
# /etc/systemd/system/court-highlights.service; not yet verified on an installed box.
# The launcher runs ch-box from its active update slot and takes failed updates back; systemd restarts the launcher.
[Unit]
Description=Court Highlights court box
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=court-highlights
Group=court-highlights
# Intel VA encoder and decoder (/dev/dri)
SupplementaryGroups=render video
# CH_DATA_DIR, CH_SLOTS_DIR, CH_SEED_BINARY, CH_RELEASE_KEY, CH_BOX_NAME, CH_PLAYER_URL, and for a
# venue with several boxes CH_VENUE_KEY and CH_PEERS (RUNBOOK §3). Readable by root and the service only.
EnvironmentFile=/etc/court-highlights/box.env
ExecStart=/bin/sh /opt/court-highlights/box-launcher.sh
Restart=always
RestartSec=2
# Footage segments close cleanly on SIGTERM; the launcher passes it on.
KillSignal=SIGTERM
TimeoutStopSec=20
# Ports 80 and 443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/court-highlights /opt/court-highlights
StateDirectory=court-highlights

[Install]
WantedBy=multi-user.target
